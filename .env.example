DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Standard OpenAI (preferred when AZURE_OPENAI_ENDPOINT is empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Azure OpenAI (same convention as Returned-Mail-AI-Web-App)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_RESPONSES_API_VERSION=2025-03-01-preview
AZURE_OPENAI_DEPLOYMENT=

# Hybrid native-text/table extraction and targeted PDF vision
AI_PDF_CHUNK_PAGES=10
AI_KEYWORD_CONTEXT_PAGES=1
AI_INPUT_MODE=hybrid
AI_ADAPTIVE_CHUNKING=true
AI_SINGLE_CALL_MAX_PAGES=8
AI_SINGLE_CALL_MAX_CHARS=80000
AI_CHUNK_MAX_CHARS=50000
AI_CHUNK_OVERLAP_PAGES=1
AI_MAX_PARALLEL_REQUESTS=2
# Optional for compatible reasoning deployments (for example GPT-5): low, medium, or high.
AI_REASONING_EFFORT=low

# Update to the rates for the configured model/deployment.
AI_INPUT_COST_PER_MILLION=2.00
AI_OUTPUT_COST_PER_MILLION=8.00

